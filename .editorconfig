root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[build]
indent_style = space
indent_size = 4
shell_variant = bash

[sign-rpms]
indent_style = space
indent_size = 4
shell_variant = bash

[create-repository]
indent_style = space
indent_size = 4
shell_variant = bash

[*.sh]
indent_style = space
indent_size = 4
shell_variant = bash

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
