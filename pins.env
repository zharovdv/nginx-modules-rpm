# Reviewed immutable inputs for pull-request and main-branch CI.
# Update these values only through a reviewed pull request.
# Update the NGINX version and matching pkg-oss commit together.
NGINX_STABLE_CI_VERSION=1.30.5
PKG_OSS_CI_COMMIT=129ae8d35db29ef41b9f610d3c2323e774d6a706
NCHAN_CI_COMMIT=08ebad812c8f4bdd3a72473cae53e634ca1b39d6
GEOIP2_CI_COMMIT=cbaa35461c62a99d2577e6bae3273492502d8769

# Full fingerprint of the dedicated RPM signing key. A release fails closed
# until this is replaced through a reviewed PR.
RPM_GPG_FINGERPRINT=REPLACE_WITH_40_CHARACTER_SIGNING_KEY_FINGERPRINT
