#!/usr/bin/env bash
set -Eeuo pipefail

die() {
    printf "ERROR: %s\n" "$*" >&2
    exit 1
}
log() { printf "==> %s\n" "$*"; }

repository_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
destination="${1:-${repository_dir}/.cache/lint-tools}"

# shellcheck source=lint-tools.env
source "${repository_dir}/lint-tools.env"

[[ "$(uname -s)" == Linux ]] || die "Automatic installation supports Linux only"
[[ "$(uname -m)" == x86_64 ]] || die "Automatic installation supports x86_64 only"

for command in curl sha256sum tar; do
    command -v "$command" >/dev/null || die "Required command not found: ${command}"
done

mkdir -p "$destination"
temporary_directory="$(mktemp -d)"
trap 'rm -rf "$temporary_directory"' EXIT

download() {
    local url="$1"
    local output="$2"
    local expected_sha256="$3"

    curl --fail --silent --show-error --location \
        --retry 3 \
        --output "$output" \
        "$url"
    printf '%s  %s\n' "$expected_sha256" "$output" | sha256sum --check --status ||
        die "Checksum verification failed for ${url}"
}

log "Installing ShellCheck ${SHELLCHECK_VERSION}"
shellcheck_archive="${temporary_directory}/shellcheck.tar.xz"
download \
    "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/shellcheck-v${SHELLCHECK_VERSION}.linux.x86_64.tar.xz" \
    "$shellcheck_archive" \
    "$SHELLCHECK_SHA256"
tar --no-same-owner -xJf "$shellcheck_archive" -C "$temporary_directory"
install -m 0755 \
    "${temporary_directory}/shellcheck-v${SHELLCHECK_VERSION}/shellcheck" \
    "${destination}/shellcheck"

log "Installing shfmt ${SHFMT_VERSION}"
shfmt_binary="${temporary_directory}/shfmt"
download \
    "https://github.com/mvdan/sh/releases/download/v${SHFMT_VERSION}/shfmt_v${SHFMT_VERSION}_linux_amd64" \
    "$shfmt_binary" \
    "$SHFMT_SHA256"
install -m 0755 "$shfmt_binary" "${destination}/shfmt"

log "Installing actionlint ${ACTIONLINT_VERSION}"
actionlint_archive="${temporary_directory}/actionlint.tar.gz"
download \
    "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" \
    "$actionlint_archive" \
    "$ACTIONLINT_SHA256"
tar --no-same-owner -xzf "$actionlint_archive" -C "$temporary_directory" actionlint
install -m 0755 "${temporary_directory}/actionlint" "${destination}/actionlint"

log "Lint tools installed in ${destination}"
